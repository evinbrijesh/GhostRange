# GhostRange environment configuration
# Copy to .env and fill in real values locally. NEVER commit .env or real keys.

# --- Persistence ---
# SQLite for the MVP; the persistence boundary must stay portable to PostgreSQL.
DATABASE_URL=sqlite:///./ghostrange.db

# --- API ---
API_ORIGIN=http://localhost:8000

# --- Nebius Token Factory (NVIDIA Nemotron) ---
# Required only for AI explanation / proposal / report features.
# Without a key the app runs in deterministic demo mode with a degraded-AI state.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=

# --- Tavily (optional threat-intel context; never required for the core demo) ---
TAVILY_API_KEY=

# --- Frontend public configuration ---
VITE_API_URL=http://localhost:8000
