{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostrange.dev/schemas/telemetry-event.schema.json",
  "title": "TelemetryEvent",
  "type": "object",
  "required": [
    "id", "runId", "stageId", "expected", "timestamp", "source",
    "identity", "action", "resource", "srcIp", "attributes", "synthetic"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^evt_[A-Za-z0-9_-]+$" },
    "runId": { "type": "string", "pattern": "^run_[A-Za-z0-9_-]+$" },
    "stageId": { "$ref": "common.schema.json#/$defs/StageId" },
    "expected": {
      "type": "boolean",
      "description": "True for events the stage's coverage check requires; false for background/negative events."
    },
    "timestamp": { "$ref": "common.schema.json#/$defs/Iso8601Utc" },
    "source": { "$ref": "common.schema.json#/$defs/EventSource" },
    "identity": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" }
      }
    },
    "action": { "type": "string" },
    "resource": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" }
      }
    },
    "srcIp": {
      "type": "string",
      "description": "Reserved documentation IP range only (192.0.2.0/24, 198.51.100.0/24, 203.0.113.0/24)."
    },
    "attributes": { "type": "object", "additionalProperties": true },
    "synthetic": { "const": true }
  }
}
