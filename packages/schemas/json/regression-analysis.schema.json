{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostrange.dev/schemas/regression-analysis.schema.json",
  "title": "RegressionAnalysisResult",
  "description": "POST /api/runs/{run_id}/regression-analysis — candidate vs baseline coverage comparison. Defaults to the committed baseline, never a hard-coded score.",
  "type": "object",
  "required": [
    "baselineRunId",
    "candidateRunId",
    "baselineCoverage",
    "candidateCoverage",
    "coverageDiff",
    "status",
    "isBlocked",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "baselineRunId": { "type": "string" },
    "candidateRunId": { "type": "string", "pattern": "^run_[A-Za-z0-9_-]+$" },
    "baselineCoverage": { "type": "number", "minimum": 0, "maximum": 100 },
    "candidateCoverage": { "type": "number", "minimum": 0, "maximum": 100 },
    "coverageDiff": { "type": "number" },
    "status": {
      "type": "string",
      "enum": ["pass", "regression_detected", "unchanged"]
    },
    "isBlocked": { "type": "boolean" },
    "summary": { "$ref": "common.schema.json#/$defs/SafeMessage" }
  }
}
