{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostrange.dev/schemas/stage-result.schema.json",
  "title": "StageResult",
  "type": "object",
  "required": ["stageId", "status", "expectedEventIds", "matchedEventIds", "matchedRuleIds", "evidenceIds", "errors"],
  "properties": {
    "stageId": { "$ref": "common.schema.json#/$defs/StageId" },
    "status": { "$ref": "common.schema.json#/$defs/StageStatus" },
    "expectedEventIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^evt_[A-Za-z0-9_-]+$" }
    },
    "matchedEventIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^evt_[A-Za-z0-9_-]+$" }
    },
    "matchedRuleIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^rule_[A-Za-z0-9_-]+$" }
    },
    "detectionLatencyMs": {
      "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }],
      "description": "Time from first expected event to first matching event; null when nothing matched."
    },
    "evidenceIds": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/EvidenceRef" }
    },
    "errors": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/SafeMessage" },
      "description": "Parser/evaluator errors for this stage. Non-empty when status is 'error'."
    },
    "mismatches": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/RuleMismatch" },
      "description": "Why each valid stage rule did not match each unmatched expected event. Background events are never included."
    }
  },
  "$defs": {
    "RuleMismatch": {
      "type": "object",
      "required": ["ruleId", "eventId", "failedExpressions"],
      "properties": {
        "ruleId": { "type": "string", "pattern": "^rule_[A-Za-z0-9_-]+$" },
        "eventId": { "type": "string", "pattern": "^evt_[A-Za-z0-9_-]+$" },
        "failedExpressions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "operator", "expected", "actual"],
            "properties": {
              "field": { "type": "string" },
              "operator": { "type": "string", "enum": ["exact", "contains"] },
              "expected": { "type": "string" },
              "actual": {
                "type": ["string", "null"],
                "description": "The value the event had; null when the field was absent on the event."
              }
            }
          }
        }
      }
    }
  }
}
